generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  displayName     String?
  locale          String           @default("ko-KR")
  timezone        String           @default("Asia/Seoul")
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  onboardingStep  String           @default("START")
  blockedBy       Block[]          @relation("BlockedByUsers")
  blockedUsers    Block[]          @relation("BlockingUsers")
  chatMessages    ChatMessage[]
  clubMemberships ClubMember[]
  consents        Consent[]
  deletionRequest DeletionRequest?
  deviceTokens    DeviceToken[]
  hostedGames     Game[]           @relation("HostedGames")
  notifications   Notification[]
  participations  Participant[]
  notificationPreferences NotificationPreference?
  ratingsMade     Rating[]         @relation("Rater")
  ratingsReceived Rating[]         @relation("TargetUser")
  reportsReceived Report[]         @relation("ReportedUser")
  reportsMade     Report[]         @relation("Reporter")
  preferences     UserPreference?
  userSports      UserSport[]
}

model Consent {
  id        String   @id @default(uuid())
  userId    String
  type      String
  version   String
  accepted  Boolean
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model DeletionRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Sport {
  id         String      @id @default(uuid())
  slug       String      @unique
  name_ko    String
  name_en    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  games      Game[]
  userSports UserSport[]
  clubs      Club[]      @relation("ClubSports")
  venues     Venue[]     @relation("VenueSports")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  homeArea        String?
  preferredRadius Int      @default(10)
  availability    Json?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model UserSport {
  id        String   @id @default(uuid())
  userId    String
  sportId   String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sport     Sport    @relation(fields: [sportId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, sportId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  platform  String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  area      String
  address   String?
  category  String
  amenities Json?
  images    Json?
  contact   String?
  mapLink   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  games     Game[]
  ratings   Rating[]
  sports    Sport[]  @relation("VenueSports")
}

model Club {
  id          String       @id @default(uuid())
  name        String
  description String?
  visibility  String       @default("PUBLIC")
  joinPolicy  String       @default("OPEN")
  homeArea    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     ClubMember[]
  games       Game[]
  ratings     Rating[]
  sports      Sport[]      @relation("ClubSports")
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  userId    String
  role      String   @default("MEMBER")
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
}

model Game {
  id           String        @id @default(uuid())
  sportId      String
  hostId       String
  venueId      String?
  clubId       String?
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  homeArea     String
  capacity     Int
  visibility   String        @default("PUBLIC")
  joinPolicy   String        @default("OPEN")
  status       String        @default("OPEN")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatMessages ChatMessage[]
  club         Club?         @relation(fields: [clubId], references: [id])
  host         User          @relation("HostedGames", fields: [hostId], references: [id])
  sport        Sport         @relation(fields: [sportId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  invites      GameInvite[]
  participants Participant[]
  ratings      Rating[]
}

model Participant {
  id        String   @id @default(uuid())
  gameId    String
  userId    String
  role      String   @default("PARTICIPANT")
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
}

model GameInvite {
  id        String    @id @default(uuid())
  gameId    String
  token     String    @unique
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  game      Game      @relation(fields: [gameId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  gameId    String
  senderId  String
  body      String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
  reports   Report[]

  @@index([gameId, createdAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id])
  blocker   User     @relation("BlockingUsers", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
}

model Rating {
  id            String   @id @default(uuid())
  gameId        String?
  raterId       String
  targetUserId  String?
  targetVenueId String?
  targetClubId  String?
  score         Int
  comment       String?
  categories    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  game          Game?    @relation(fields: [gameId], references: [id])
  rater         User     @relation("Rater", fields: [raterId], references: [id])
  targetClub    Club?    @relation(fields: [targetClubId], references: [id])
  targetUser    User?    @relation("TargetUser", fields: [targetUserId], references: [id])
  targetVenue   Venue?   @relation(fields: [targetVenueId], references: [id])
  reports       Report[] @relation("ReportedRating")

  @@unique([raterId, gameId, targetUserId])
  @@unique([raterId, gameId, targetVenueId])
  @@unique([raterId, targetClubId])
  @@index([targetUserId])
  @@index([targetVenueId])
  @@index([targetClubId])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reportedId   String
  messageId    String?
  ratingId     String?
  gameId       String?
  reasonCode   String
  note         String?
  status       String       @default("PENDING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  message      ChatMessage? @relation(fields: [messageId], references: [id])
  rating       Rating?      @relation("ReportedRating", fields: [ratingId], references: [id])
  reportedUser User         @relation("ReportedUser", fields: [reportedId], references: [id])
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String   @default("Asia/Seoul")
  typesEnabled    Json     @default("{\"chat\": true, \"game\": true}")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}
